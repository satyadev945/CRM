# Environment Variables Template for Cloud Deployment
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# ===== Database Configuration =====
DATABASE_URL=jdbc:mysql://your-rds-endpoint.region.rds.amazonaws.com:3306/crm?useSSL=true&serverTimezone=UTC
DATABASE_USERNAME=admin
DATABASE_PASSWORD=your-secure-password
DB_DDL_AUTO=validate

# Database Connection Pool
DB_POOL_SIZE=20
DB_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# ===== AWS Configuration =====
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-crm-pdfs-bucket

# AWS Credentials (use IAM role in production instead)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ===== Application Configuration =====
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=cloud

# PDF Storage
PDF_STORAGE_TYPE=s3

# ===== Logging Configuration =====
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# ===== Thymeleaf Configuration =====
THYMELEAF_CACHE=true

# ===== File Upload Configuration =====
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# ===== Spring Application Name =====
SPRING_APPLICATION_NAME=crm-app
