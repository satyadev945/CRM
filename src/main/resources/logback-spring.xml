<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <!-- Console Appender with JSON format for cloud environments -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>correlationId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <customFields>{"application":"minicompcrm","environment":"${ENVIRONMENT:-dev}"}</customFields>
        </encoder>
    </appender>
    
    <!-- Console Appender with standard format for local development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- Use JSON logging in cloud environments, standard logging locally -->
    <springProfile name="cloud,aws,prod">
        <root level="${LOG_LEVEL:-INFO}">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>
    
    <springProfile name="!cloud,!aws,!prod">
        <root level="${LOG_LEVEL:-INFO}">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
    
    <!-- Application-specific logging -->
    <logger name="crm" level="${APP_LOG_LEVEL:-INFO}"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.hibernate" level="WARN"/>
    
</configuration>
